# ─────────────────────────────────────────────────────────────────────────────
# VoltKey Frontend — Environment Variables
# Paste your Supabase values here (found in: Supabase Dashboard → Project Settings → API)
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# VoltKey backend URL (change for production)
NEXT_PUBLIC_API_URL=http://localhost:8000
